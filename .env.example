# Required for /contact form submissions to reach the "Safety Margin Funnel"
# Supabase project (same database the safetymargin.app quiz writes to).
#
# Get these from the Supabase dashboard:
#   Project Settings -> API -> Project URL          -> SUPABASE_URL
#   Project Settings -> API -> service_role (secret) -> SUPABASE_SERVICE_ROLE_KEY
#
# Local dev: copy this file to .env.local and fill in real values (.env.local is
# gitignored, never commit real values). Production (Vercel): set the same two
# names under Project Settings -> Environment Variables.
#
# The service_role key bypasses row-level security — it is used ONLY in
# src/app/contact/actions.ts, a Server Action that never runs in the browser.
# Never prefix these with NEXT_PUBLIC_ or reference them from a Client Component.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
