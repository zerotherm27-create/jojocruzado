# Required for /contact form submissions to reach the "Safety Margin Funnel"
# Supabase project (same database the safetymargin.app quiz writes to).
#
# Get these from the Supabase dashboard:
#   Project Settings -> API -> Project URL          -> SUPABASE_URL
#   Project Settings -> API -> service_role (secret) -> SUPABASE_SERVICE_ROLE_KEY
#
# Local dev: copy this file to .env.local and fill in real values (.env.local is
# gitignored, never commit real values). Production (Vercel): set the same two
# names under Project Settings -> Environment Variables.
#
# The service_role key bypasses row-level security — it is used ONLY in
# src/app/contact/actions.ts, a Server Action that never runs in the browser.
# Never prefix these with NEXT_PUBLIC_ or reference them from a Client Component.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required for the /admin dashboard (login form + the public pages reading
# articles/site settings). Same Supabase project as above.
#
# Get these from the Supabase dashboard:
#   Project Settings -> API -> Project URL       -> NEXT_PUBLIC_SUPABASE_URL
#   Project Settings -> API -> anon / publishable -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# These ARE safe to expose to the browser (that's what "anon" / "publishable" means)
# unlike SUPABASE_SERVICE_ROLE_KEY above — do not confuse the two.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The one email allowed into /admin, checked in middleware and in every admin
# Server Action — NOT just "is someone logged in". Must exactly match the email
# of the one Supabase Auth user you create (Dashboard -> Authentication -> Users).
# Without this set, /admin is unreachable even with valid Supabase Auth login.
ADMIN_EMAIL=

# Required for the site-wide chat widget (src/app/api/chat/route.ts) to reach
# OpenAI. Get this from platform.openai.com -> API keys.
#
# Server-only, same rule as SUPABASE_SERVICE_ROLE_KEY above — used only in
# src/lib/openai/client.ts, called from the Route Handler, never a Client
# Component. Never prefix with NEXT_PUBLIC_. Without this set, the chat
# widget still renders but replies with a friendly "having trouble" fallback
# (see src/app/api/chat/route.ts) rather than failing the build.
OPENAI_API_KEY=
